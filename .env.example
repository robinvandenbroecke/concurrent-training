# Core
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/concurrent_training
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
AUTO_CREATE_TABLES=true

# API protection
REQUIRE_API_KEY=false
ADMIN_API_KEY=replace-with-at-least-24-random-characters
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Model runtime
USE_LEGACY_MODEL=false
DAY_LEVEL_STRENGTH_TARGET_MODE=heaviest_quality_set_perf_y

# Strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/integrations/strava/callback
STRAVA_SCOPES=read,activity:read_all
APP_BASE_URL=http://localhost:8000
STRAVA_STATE_TTL_SECONDS=600
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STRAVA_TOKEN_ENCRYPTION_KEY=

# Production requirements:
# APP_ENV=production
# REQUIRE_API_KEY=true
# AUTO_CREATE_TABLES=false
# set strong ADMIN_API_KEY and STRAVA_TOKEN_ENCRYPTION_KEY
